{
  "name": "КПЦ Симбирск — ориентировка",
  "short_name": "Ориентировка",
  "description": "Офлайн-генератор ориентировок КПЦ Симбирск",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f2f3f5",
  "theme_color": "#b90000",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "tracks",
          "accept": [
            "application/octet-stream",
            "application/gpx+xml",
            "application/xml",
            "text/xml",
            "text/plain",
            "application/vnd.ant.fit",
            "application/vnd.garmin.tcx+xml",
            "application/vnd.google-earth.kml+xml",
            "application/vnd.google-earth.kmz"
          ]
        }
      ]
    }
  },
  "related_applications": [
    {
      "platform": "webapp",
      "url": "./manifest.webmanifest",
      "id": "https://lidia932.github.io/kpc-orientirovka/"
    }
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
