rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownerEmail() {
      return signedIn() && request.auth.token.email == 'lidiya.lynx@gmail.com';
    }

    function ownerIdentity() {
      return ownerEmail()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function approved() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true;
    }

    function admin() {
      return approved()
        && ownerEmail()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'approved', 'role', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && (
          (ownerIdentity() && request.resource.data.approved == true && request.resource.data.role == 'admin')
          || (!ownerEmail() && request.resource.data.approved == false && request.resource.data.role == 'member')
        );
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow update: if admin()
        && userId != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved']);
      allow delete: if admin() && userId != request.auth.uid;
    }

    match /cases/{caseId} {
      allow read: if approved();
      allow create: if approved()
        && request.resource.data.keys().hasOnly([
          'type', 'status', 'title', 'data', 'poster', 'createdAt', 'createdBy', 'createdByEmail'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.type in ['ПСС', 'ПТП']
        && request.resource.data.poster.size() <= 768000;
      allow update: if approved()
        && resource.data.status == 'active'
        && request.resource.data.status == 'archive'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'archivedAt', 'archivedBy']);
      allow delete: if approved() && resource.data.status == 'active';
    }

    match /notes/{noteId} {
      allow read: if approved();
      allow create: if approved()
        && request.resource.data.keys().hasOnly([
          'caseId', 'contentHtml', 'image', 'imageType',
          'authorId', 'authorName', 'authorEmail', 'createdAt', 'updatedAt'
        ])
        && exists(/databases/$(database)/documents/cases/$(request.resource.data.caseId))
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.authorName.size() <= 120
        && request.resource.data.contentHtml.size() <= 20000
        && request.resource.data.image.size() <= 600000
        && request.resource.data.imageType in ['', 'image/jpeg'];
      allow update: if approved()
        && (resource.data.authorId == request.auth.uid || admin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'contentHtml', 'image', 'imageType', 'updatedAt'
        ])
        && request.resource.data.contentHtml.size() <= 20000
        && request.resource.data.image.size() <= 600000
        && request.resource.data.imageType in ['', 'image/jpeg'];
      allow delete: if approved()
        && (
          resource.data.authorId == request.auth.uid
          || admin()
          || !exists(/databases/$(database)/documents/cases/$(resource.data.caseId))
        );
    }
  }
}
