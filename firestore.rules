rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownerEmail() {
      return signedIn() && request.auth.token.email == 'lidiya.lynx@gmail.com';
    }

    function ownerIdentity() {
      return ownerEmail()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function approved() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true;
    }

    function admin() {
      return approved()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'approved', 'role', 'createdAt', 'photo', 'photoType'])
        && request.resource.data.email == request.auth.token.email
        && (
          (ownerIdentity() && request.resource.data.approved == true && request.resource.data.role == 'admin')
          || (!ownerEmail() && request.resource.data.approved == false && request.resource.data.role == 'member')
        );
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || admin()
          || (approved() && resource.data.approved == true)
        );
      allow update: if (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photo', 'photoType'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName'])
          || (
            request.resource.data.displayName is string
            && request.resource.data.displayName.size() >= 2
            && request.resource.data.displayName.size() <= 80
          )
        )
        && (
          !request.resource.data.keys().hasAny(['photo', 'photoType'])
          || (
            request.resource.data.keys().hasAll(['photo', 'photoType'])
            && request.resource.data.photo.size() <= 150000
            && request.resource.data.photoType in ['', 'image/jpeg']
          )
        )
      ) || (
        admin()
        && userId != request.auth.uid
        && (
          (
            ownerEmail()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved', 'role'])
            && request.resource.data.role in ['member', 'admin']
            && (request.resource.data.role == 'member' || request.resource.data.approved == true)
          )
          || (
            resource.data.role == 'member'
            && request.resource.data.role == 'member'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved'])
          )
        )
      );
      allow delete: if admin()
        && userId != request.auth.uid
        && resource.data.approved == false
        && resource.data.role == 'member';
    }

    match /cases/{caseId} {
      allow read: if approved();
      allow create: if admin()
        && request.resource.data.keys().hasOnly([
          'type', 'status', 'title', 'data', 'poster', 'createdAt', 'createdBy', 'createdByEmail'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.type in ['ПСС', 'ПТП']
        && request.resource.data.poster.size() <= 768000;
      allow update: if admin()
        && (
          (
            resource.data.status == 'active'
            && request.resource.data.status == 'archive'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'archivedAt', 'archivedBy'
            ])
          )
          || (
            resource.data.status in ['active', 'archive']
            && request.resource.data.status == 'archive'
            && request.resource.data.archivedBy == request.auth.uid
            && request.resource.data.archiveUrl.matches('https://drive\\.google\\.com/.*')
            && request.resource.data.driveFileId.size() <= 200
            && request.resource.data.archiveFileName.size() <= 240
            && !request.resource.data.keys().hasAny(['poster', 'data', 'createdByEmail'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'archiveUrl', 'driveFileId', 'archiveFileName',
              'archivedAt', 'archivedBy', 'poster', 'data', 'createdByEmail'
            ])
          )
        );
      allow delete: if admin() && resource.data.status == 'active';
    }

    match /notes/{noteId} {
      allow read: if approved();
      allow create: if approved()
        && request.resource.data.keys().hasOnly([
          'caseId', 'contentHtml', 'image', 'imageType',
          'authorId', 'authorName', 'authorEmail', 'createdAt', 'updatedAt'
        ])
        && exists(/databases/$(database)/documents/cases/$(request.resource.data.caseId))
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.authorName.size() <= 120
        && request.resource.data.contentHtml.size() <= 20000
        && request.resource.data.image.size() <= 600000
        && request.resource.data.imageType in ['', 'image/jpeg'];
      allow update: if approved()
        && (resource.data.authorId == request.auth.uid || admin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'contentHtml', 'image', 'imageType', 'updatedAt'
        ])
        && request.resource.data.contentHtml.size() <= 20000
        && request.resource.data.image.size() <= 600000
        && request.resource.data.imageType in ['', 'image/jpeg'];
      allow delete: if approved()
        && (
          resource.data.authorId == request.auth.uid
          || admin()
        );
    }
  }
}
